{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "includes": ["src/**", ".vscode/**", "*.json", "*.ts"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noDescendingSpecificity": "off"
            },
            "a11y": {
                "useButtonType": "off",
                "useSemanticElements": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            }
        }
    }
}
