{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffie",
  "version": "0.1.0",
  "identifier": "dev.elara.diffie",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Diffie",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
